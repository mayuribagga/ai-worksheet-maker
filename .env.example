# Copy this file to .env.local and fill in the values from
# your Supabase project (Connect button → App Frameworks → Next.js).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Claude API key from platform.claude.com. Server-side only, so never
# prefix it with NEXT_PUBLIC_ or it will be sent to the browser.
ANTHROPIC_API_KEY=
